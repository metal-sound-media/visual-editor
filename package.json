{
  "name": "@metalsoundmedia/visual-editor",
  "version": "0.2.0",
  "type": "module",
  "main": "VisualEditor.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ciklik/visual-editor"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"php -S 0.0.0.0:8000 -ddisplay_errors=1 -t server/\"",
    "build": "vite build && cp package.json dist/package.json",
    "serve": "vite preview",
    "format": "prettier --config .prettierrc 'src/**/*.{js,ts}' --write",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "xvfb-run --auto-servernum start-server-and-test 'php -S 0.0.0.0:8000 -ddisplay_errors=1 -q' http://localhost:8000 'npx cypress run'",
    "test:e2e:watch": "start-server-and-test 'php -S 0.0.0.0:8000 -ddisplay_errors=1 -q' http://localhost:8000 'npx cypress open'",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "sortablejs": "^1.15.3"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "cypress": "^15.6.0",
    "prettier": "^3.0.3",
    "start-server-and-test": "^2.0.1",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "volta": {
    "node": "22.17.1"
  }
}
