# CI/Test image — Node + PHP + Composer + Cypress (Debian, includes Electron dependencies)
FROM cypress/base:22.11.0
RUN apt-get update -qq \
  && apt-get install -y -qq --no-install-recommends php-cli php-mbstring curl unzip \
  && rm -rf /var/lib/apt/lists/*
RUN curl -sS https://getcomposer.org/installer | php -- \
    --install-dir=/usr/local/bin --filename=composer
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY composer*.json ./
RUN composer install --no-dev --optimize-autoloader
COPY . .
CMD ["sh", "-c", "npm run build && npm test"]
