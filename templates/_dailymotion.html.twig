{% set videoId = (block.url|split('https://www.dailymotion.com/video/'))[1] %}

<div class="text-center mt-3 mb-3">
    <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;">
        <iframe style="width:100%;height:100%;position:absolute;left:0;top:0;overflow:hidden" frameborder="0"
                type="text/html" src="https://www.dailymotion.com/embed/video/{{ videoId }}" width="100%" height="100%"
                allowfullscreen></iframe>
    </div>
</div>
